# ==========================================================================
# Emily OS — ignore rules
# ==========================================================================

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.eggs/
.python-version

# --- Tooling caches ---
.mypy_cache/
.ruff_cache/
.pytest_cache/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Editors / OS ---
.idea/
.vscode/
.cursor/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# --- Secrets (never commit) ---
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
*.secret

# --- Runtime state & logs (large, machine-specific) ---
data/
!data/.gitkeep
logs/
!logs/.gitkeep
models/
!models/.gitkeep
*.log

# --- Large model weights / binaries ---
*.pt
*.pth
*.onnx
*.bin
*.safetensors
*.gguf
*.db
*.sqlite
*.sqlite3
*.wav
*.mp3
*.mp4
!brag-output/brag.mp4
!brag-output/composition/assets/music/*.mp3

# --- Node / frontend build ---
node_modules/
apps/**/dist/
apps/**/src-tauri/target/

# --- Dead pre-M0 scaffold (retained locally, not part of the platform) ---
/app/

# --- Ad-hoc scratch files ---
scratch.js
test_audio.wav
test_sd.py
test_shazam.py
test_shazam_loop.py
test_vision.py

# --- Separate project (has its own git remote) ---
ObligaX/

# --- /brag build artifacts (keep the composition source + final render) ---
brag-output/composition/.hyperframes/
brag-output/composition/.thumbnails/
brag-output/composition/.waveform-cache/
brag-output/composition/renders/
brag-output/composition/snapshots/
brag-output/composition/assets/music/audio-data.json
brag-output/composition/assets/music/happy-beats-business-moves-vol-12-by-ende-dot-app.mp3
brag-output/composition/assets/music/cues/happy-beats-business-moves-vol-12-by-ende-dot-app.music-cues.*

# --- HyperFrames project caches (generic) ---
.hyperframes/
.thumbnails/
.waveform-cache/
