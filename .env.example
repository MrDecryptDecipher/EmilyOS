##############################################################
# Emily OS — environment template (no secrets)
# Copy to .env and fill in values.
##############################################################

EMILY_APP_NAME=Emily OS
EMILY_APP_VERSION=0.1.0
EMILY_ENVIRONMENT=development
EMILY_LOG_LEVEL=INFO
EMILY_DEBUG=false

# Windows: HF cache without symlinks (set in shell/.env — not an Emily setting)
# HF_HUB_DISABLE_SYMLINKS=1
# HF_HUB_DISABLE_SYMLINKS_WARNING=1

##############################################################
# Providers
##############################################################

EMILY_PRIMARY_PROVIDER=nvidia
EMILY_BACKUP_PROVIDER=routesme

EMILY_NVIDIA_API_KEY=
EMILY_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
EMILY_NVIDIA_MODEL=z-ai/glm-5.2

EMILY_ROUTESME_API_KEY=
EMILY_ROUTESME_BASE_URL=https://routesme.online/v1
EMILY_ROUTESME_MODEL=DeepSeek-V4-Flash-0731

EMILY_PROVIDER_TIMEOUT_SECONDS=120
EMILY_PROVIDER_MAX_RETRIES=2
EMILY_PROVIDER_FAILOVER_ENABLED=true

##############################################################
# Missions / Agents
##############################################################

EMILY_MISSION_LLM_PLANNER=true
EMILY_AGENT_MAX_CONCURRENT=8
EMILY_AGENT_POOL_TIMEOUT_SECONDS=30
EMILY_AGENT_LLM_WORKERS=true
EMILY_AGENT_LLM_TIMEOUT_SECONDS=45
EMILY_AGENT_HISTORY_ENABLED=true
EMILY_AGENT_HISTORY_DIRECTORY=data/agents

##############################################################
# Capability flags
##############################################################

EMILY_VOICE_ENABLED=false
EMILY_WAKE_WORD=Hey Emily
EMILY_VOICE_WAKE_WORD_ENABLED=false
EMILY_VOICE_WAKE_WORD_THRESHOLD=0.5
# Optional openWakeWord ONNX model path (custom KWS). If unset, ASR phrase mode matches EMILY_WAKE_WORD.
# EMILY_VOICE_WAKE_WORD_MODEL=models/voice/wake/emily.onnx
EMILY_VOICE_WAKE_WORD_MAX_LISTEN_S=8.0
EMILY_VOICE_WAKE_WORD_LISTEN_CHUNK_S=5.0
EMILY_VOICE_LISTEN_CHUNK_S=8.0
EMILY_VOICE_PREFER_ENERGY_VAD=true
EMILY_VOICE_UI_PORT=8765
EMILY_VOICE_DIRECTORY=data/voice
EMILY_VOICE_MODELS_DIRECTORY=models/voice
EMILY_VOICE_REGISTER_TOOLS=true
EMILY_VOICE_STREAMING=true
EMILY_VOICE_BARGE_IN=true
EMILY_VOICE_LANGUAGE_AUTO_DETECT=true
EMILY_VOICE_CODE_SWITCHING=true
EMILY_VOICE_EMOTION=true
EMILY_VOICE_ADAPTIVE_PACING=true
EMILY_VOICE_ADAPTIVE_PAUSES=true
EMILY_VOICE_TTS_STREAM_SENTENCES=false
EMILY_VOICE_PRELOAD_MODELS=true
EMILY_VOICE_KEEP_MODELS_WARM=true
EMILY_VOICE_MIC_MIN_RMS=0.001
EMILY_VOICE_LLM_TIMEOUT_SECONDS=45
EMILY_TTS_DEFAULT=voicebox
EMILY_TTS_ENABLE_KOKORO=true
EMILY_TTS_ENABLE_INDICF5=false
EMILY_TTS_ENABLE_CHATTERBOX=false
EMILY_TTS_ENABLE_VOICEBOX=true
EMILY_TTS_DEVICE=cuda
EMILY_VOICE_TTS_PREFER_LIGHTWEIGHT=false
EMILY_VOICE_VOICEBOX_URL=http://127.0.0.1:17493
EMILY_VOICE_VOICEBOX_PROFILE=Emily
EMILY_VOICE_VOICEBOX_USE_PRESETS=true
EMILY_VOICE_VOICEBOX_ENGINE=auto
EMILY_VOICE_VOICEBOX_PERSONALITY=false
EMILY_VOICE_VOICEBOX_PRESET_KOKORO_EN=af_bella
EMILY_VOICE_VOICEBOX_PRESET_KOKORO_HI=hf_beta
# small = better Hindi/Hinglish; base = faster on CPU
EMILY_VOICE_ASR_MODEL=small
# Leave unset for auto (English + Hindi + Bengali + code-switch). Set hi/bn only if you always speak one language.
# EMILY_VOICE_ASR_LANGUAGE=hi
EMILY_VOICE_BANGLA_ASR_ENABLED=true
EMILY_VOICE_BANGLA_ASR_MODEL=bangla-speech-processing/BanglaASR
EMILY_MEMORY_ENABLED=true
EMILY_MEMORY_DIRECTORY=data/memory
EMILY_WORLD_DIRECTORY=data/world
EMILY_MEMORY_RETRIEVAL_LIMIT=8
EMILY_TOOLS_ENABLED=true
EMILY_TOOL_TIMEOUT_SECONDS=15
EMILY_TOOL_ALLOW_EXECUTE=true
EMILY_ALLOW_NETWORK=false
EMILY_MCP_CATALOG_PATH=data/mcp/catalog.json
EMILY_CHAT_HISTORY_DIRECTORY=data/history
EMILY_VISION_ENABLED=false
EMILY_OCR_ENABLED=false
EMILY_DESKTOP_ENABLED=true
EMILY_DESKTOP_CONTROL=true
EMILY_DESKTOP_LIVE=true
EMILY_DESKTOP_POWERSHELL=false
EMILY_DESKTOP_REGISTRY=true
EMILY_DESKTOP_REGISTRY_WRITE=false
EMILY_DESKTOP_REGISTER_TOOLS=true
EMILY_BROWSER_ENABLED=true
EMILY_BROWSER_AUTOMATION=true
EMILY_BROWSER_HEADLESS=true
EMILY_BROWSER_PROFILE=default
EMILY_BROWSER_PROFILES_DIRECTORY=data/browser/profiles
EMILY_BROWSER_REGISTER_TOOLS=true

##############################################################
# Security defaults (least privilege recommended in production)
##############################################################

EMILY_ALLOW_TERMINAL=false
EMILY_ALLOW_FILE_WRITE=false
EMILY_ALLOW_BROWSER=false
EMILY_ALLOW_SYSTEM_COMMANDS=false
EMILY_CONFIRM_DESTRUCTIVE_ACTIONS=true
